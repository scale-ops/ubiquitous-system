# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The same names go in Vercel: Project -> Settings -> Environment Variables.

# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appqmAg1Av6yheTUu

# Claude: either an API key, or (as on Vercel today) a gateway URL plus its token
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Optional model override (default is set in lib/claude.ts)
CLAUDE_MODEL=

# Shared password login (being replaced by Google sign-in)
APP_PASSWORD=

# Google sign-in and the shared mailbox (see the "Google setup for the Screening Hub" guide)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHARED_MAILBOX=recruiting@outlier.ai
# Make one with: openssl rand -base64 32
AUTH_SECRET=

# Scheduling test mode: 1 = fake calendars, no real events or emails.
# Also on automatically when GOOGLE_REFRESH_TOKEN is empty.
SCHEDULING_TEST_MODE=
